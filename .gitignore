# ---------------------------------------------------------------------------
# Orvelle — files that must never reach the repository
#
# Keep this list short and deliberate. Everything not listed here IS part of
# the template: src/, public/, index.html, vite.config.js and the lockfile all
# need to be uploaded for the GitHub Actions build to work.
# ---------------------------------------------------------------------------

# Dependencies — reinstalled from package-lock.json by CI. Never upload this
# folder: it is tens of thousands of files and will break drag-and-drop.
node_modules/
.pnp
.pnp.js

# Build output — regenerated by `npm run build`
dist/
dist-ssr/
*.local

# Vite / tooling caches
.vite/
.cache/
.temp/
.turbo/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment and secrets
.env
.env.*
!.env.example

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating system noise — macOS in particular will add these to a folder the
# moment you open it in Finder, and they are the most common cause of stray
# files appearing in a drag-and-drop upload.
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Python helper used to cut out the product shots
__pycache__/
*.py[cod]
.venv/
venv/

# Large intermediates: the un-matted product renders. Keep them locally so the
# asset pipeline can be re-run, but they are not needed to build the site.
public/images/products/*-raw.png
public/images/journal/cover.png

# Smoke-test output (tools/smoke.mjs)
tools/shot-*.png

# Originals kept so tools/extend_rooms.py can be re-run
public/images/rooms/*-src.jpg
